# Copy to .env and fill in for local dev. All KCP_* vars map 1:1 to
# fields on config/settings.py:Settings.

KCP_DATABASE_URL=postgresql+psycopg2://kcp:kcp@localhost:5432/kcp
KCP_RAW_DATA_DIR=data/raw
KCP_STAGING_DATA_DIR=data/staging
KCP_CURATED_DATA_DIR=data/curated
KCP_REQUEST_TIMEOUT_SECONDS=30
KCP_MAX_RETRIES=4
KCP_FRESHNESS_SLA_HOURS=48

# Optional - Slack incoming webhook for observability alerts
KCP_ALERT_WEBHOOK_URL=

# Optional - dbt profile vars (see dbt/profiles.yml.example)
KCP_DB_HOST=localhost
KCP_DB_PORT=5432
KCP_DB_USER=kcp
KCP_DB_PASSWORD=kcp
KCP_DB_NAME=kcp
