# Local host access. Containers use service DNS and internal port 5432.
KCP_HOST_DB_PORT=5433
KCP_HOST_REDIS_PORT=6379
KCP_DATABASE_URL=postgresql+psycopg2://kcp:kcp@localhost:5433/kcp
KCP_REDIS_URL=redis://localhost:6379/0
KCP_DB_HOST=localhost
KCP_DB_PORT=5433
KCP_DB_USER=kcp
KCP_DB_PASSWORD=kcp
KCP_DB_NAME=kcp
KCP_RAW_DATA_DIR=data/raw
KCP_STAGING_DATA_DIR=data/staging
KCP_CURATED_DATA_DIR=data/curated
KCP_REQUEST_TIMEOUT_SECONDS=30
KCP_MAX_RETRIES=4
KCP_MAX_DOWNLOAD_BYTES=52428800
KCP_FRESHNESS_SLA_HOURS=48
KCP_ALERT_WEBHOOK_URL=
