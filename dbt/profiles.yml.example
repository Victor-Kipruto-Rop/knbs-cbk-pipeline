# Copy to ~/.dbt/profiles.yml (or set DBT_PROFILES_DIR to this repo) and
# fill in credentials via env vars. Points at the same Postgres database
# that warehouse/loaders/postgres_loader.py writes staging.economic_indicators
# into — dbt only reads from staging and builds marts on top, it never
# writes staging itself.

knbs_cbk_pipeline:
  target: dev
  outputs:
    dev:
      type: postgres
      host: "{{ env_var('KCP_DB_HOST', 'localhost') }}"
      port: "{{ env_var('KCP_DB_PORT', '5432') | int }}"
      user: "{{ env_var('KCP_DB_USER', 'kcp') }}"
      password: "{{ env_var('KCP_DB_PASSWORD', 'kcp') }}"
      dbname: "{{ env_var('KCP_DB_NAME', 'kcp') }}"
      schema: marts
      threads: 4
    prod:
      type: postgres
      host: "{{ env_var('KCP_DB_HOST') }}"
      port: "{{ env_var('KCP_DB_PORT', '5432') | int }}"
      user: "{{ env_var('KCP_DB_USER') }}"
      password: "{{ env_var('KCP_DB_PASSWORD') }}"
      dbname: "{{ env_var('KCP_DB_NAME') }}"
      schema: marts
      threads: 8
